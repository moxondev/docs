{
    "name": "moxon",
    "version": "6.0.0",
    "license": "BSD-3-Clause",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev -H 127.0.0.1 -p 4815",
        "predev": "npm run gen",
        "gen": "tsx scripts/pages.ts && tsx scripts/public.ts",
        "prebuild": "npm run gen",
        "build": "next build",
        "postbuild": "tsx scripts/redirects.ts",
        "start": "npx serve out -p 4816",
        "weight": "tsx scripts/weight.ts",
        "lint": "eslint",
        "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
        "check": "tsx scripts/pages.ts --check && tsx scripts/messages.ts && tsx scripts/charter.ts && tsc --noEmit && eslint . && prettier --check . && npm run test",
        "format": "prettier --write . && eslint --fix ."
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.55.0",
        "minisearch": "^7.2.0",
        "next": "16.4.2",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.7.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-import": "^2.32.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
}
